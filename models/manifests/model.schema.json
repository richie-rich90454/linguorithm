{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
        "version",
        "task",
        "sha256",
        "artifact",
        "language",
        "provenance",
        "inputSchema",
        "outputSchema",
        "training",
        "evaluation",
        "calibration",
        "limitations"
    ],
    "properties": {
        "version": { "type": "string" },
        "task": { "enum": ["pos", "parser", "error-classifier"] },
        "artifact": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "language": { "const": "en-US" },
        "provenance": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": ["source", "license", "permittedUse", "sha256"]
            }
        },
        "inputSchema": { "type": "object" },
        "outputSchema": { "type": "object" },
        "training": {
            "type": "object",
            "required": ["seed", "dependencies", "configuration", "splitPolicy", "quantization"]
        },
        "evaluation": { "type": "object" },
        "calibration": { "type": "object" },
        "limitations": { "type": "array", "items": { "type": "string" } }
    }
}
