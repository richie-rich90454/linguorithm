{
    "name": "grammar-intelligence-platform",
    "version": "0.2.0",
    "private": true,
    "description": "Local-first, non-generative grammar analysis and adaptive learning",
    "scripts": {
        "dev": "pnpm --filter @grammar/web dev",
        "lint": "oxlint .",
        "format": "oxfmt .",
        "format:check": "oxfmt --check .",
        "typecheck": "pnpm -r --if-present typecheck",
        "test": "pnpm -r --if-present test",
        "build": "pnpm -r --if-present build",
        "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
        "test:browser": "playwright test",
        "evaluate": "tsx scripts/evaluate.ts",
        "validate:content": "tsx scripts/validate-content.ts",
        "check:bundle": "node scripts/check-bundle.mjs",
        "benchmark": "tsx scripts/benchmark.ts",
        "inspect:ui": "node scripts/inspect-ui.mjs",
        "validate:models": "node scripts/validate-models.mjs",
        "benchmark:browser": "node scripts/benchmark-browser.mjs",
        "evaluate:ablation": "tsx scripts/ablate-browser.mts",
        "evaluate:compare": "tsx scripts/compare-systems.mts"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@playwright/test": "^1.64.1",
        "@types/node": "^26.6.5",
        "fast-check": "^4.10.2",
        "oxfmt": "^0.74.0",
        "oxlint": "^1.89.0",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    },
    "packageManager": "pnpm@12.14.0"
}
